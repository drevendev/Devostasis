{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drevendev/Devostasis/schemas/code-policy-v2.schema.json",
  "description": "Shape constraints; executable admission additionally enforces canonical bytes, source proofs, unique sorted paths, cross-field limits and exact replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "grammar",
    "include",
    "exclude",
    "source_roots",
    "budget",
    "limits",
    "history"
  ],
  "properties": {
    "contract": {
      "const": "devostasis.code-policy.v2"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "grammar": {
      "const": "PYTHON_3_12"
    },
    "include": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f]+$"
      }
    },
    "exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f]+$"
      }
    },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "const": "."
          },
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000-\\u001f]+$"
          }
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_files",
        "max_file_bytes",
        "max_total_bytes",
        "seconds"
      ],
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complexity",
        "function_lines",
        "file_lines"
      ],
      "properties": {
        "complexity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "function_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "file_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "days",
        "max_commits",
        "max_ancestors",
        "max_objects",
        "max_proof_bytes",
        "max_blob_bytes",
        "max_diff_work",
        "max_diff_lines"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "max_commits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_ancestors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_objects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "max_proof_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "max_blob_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "max_diff_work": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_diff_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      }
    }
  }
}
