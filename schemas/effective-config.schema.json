{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drevendev/devostasis/schemas/effective-config.schema.json",
  "title": "Effective bundle config (devostasis.effective-config.v2, PV-EFFECTIVE-CONFIG-001)",
  "description": "Exactly the resolved configuration values that can change canonical bundle members. Persisted verbatim in canonical form as effective-config.json; its SHA-256 is effective_config_digest and enters bundle identity.",
  "type": "object",
  "required": ["schema", "planning", "debt_mapping", "report_html", "locale", "activity", "activity_list_cap", "observations_member", "display", "demand"],
  "properties": {
    "schema": { "const": "devostasis.effective-config.v2" },
    "planning": {
      "type": "object",
      "required": ["source", "path", "link_marker"],
      "properties": {
        "source": { "enum": ["milestones", "file", "none"] },
        "path": { "type": ["string", "null"] },
        "link_marker": { "type": "string" }
      },
      "additionalProperties": false
    },
    "debt_mapping": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["source", "labels", "mapping_version"],
          "properties": {
            "source": { "const": "labels" },
            "labels": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "mapping_version": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source", "path", "mapping_version"],
          "properties": {
            "source": { "const": "file" },
            "path": { "type": "string" },
            "mapping_version": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "report_html": { "enum": ["ENABLED", "DISABLED"] },
    "locale": { "enum": ["en"] },
    "activity": { "enum": ["ENABLED", "DISABLED"] },
    "activity_list_cap": { "type": "integer", "minimum": 0 },
    "observations_member": { "enum": ["ENABLED", "DISABLED"] },
    "display": {
      "type": "object",
      "required": ["vitals", "gauge", "sections"],
      "properties": {
        "vitals": { "type": "array", "minItems": 1, "items": { "enum": ["horizon", "clutter", "direction", "flow", "integrity", "debt", "pulse"] } },
        "gauge": { "type": "array", "minItems": 1, "items": { "enum": ["bar", "number", "band"] } },
        "sections": { "type": "array", "items": { "enum": ["demand", "details", "observability", "changes", "activity", "provenance"] } }
      },
      "additionalProperties": false
    },
    "demand": {
      "type": "object",
      "required": ["mapping_version", "levels"],
      "properties": {
        "mapping_version": { "type": "string" },
        "levels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "MINIMAL"] }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
