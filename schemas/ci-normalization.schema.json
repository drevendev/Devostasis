{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "project",
    "outcome_map",
    "observed_at",
    "configured",
    "coverage",
    "revisions",
    "parents",
    "children",
    "rerun_links"
  ],
  "properties": {
    "contract": {
      "const": "devostasis.ci-normalization.v1"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "outcome_map": {
      "enum": [
        "devostasis.ci-outcomes.github.v1",
        "devostasis.ci-outcomes.gitlab.v1"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "configured": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "coverage": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "STALE",
        "UNAVAILABLE"
      ]
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revision"
      },
      "maxItems": 10000
    },
    "parents": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parent"
          },
          "maxItems": 10000
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pages"
          ],
          "properties": {
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ordinal",
                  "has_next",
                  "items"
                ],
                "properties": {
                  "ordinal": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "has_next": {
                    "type": "boolean"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/parent"
                    },
                    "maxItems": 10000
                  }
                }
              },
              "minItems": 1,
              "maxItems": 1000
            }
          }
        }
      ]
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/child"
      },
      "maxItems": 10000
    },
    "rerun_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rerun_link"
      },
      "maxItems": 10000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drevendev/Devostasis/schemas/ci-normalization.schema.json",
