{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drevendev/Devostasis/schemas/code-manifest-v2.schema.json",
  "description": "Shape constraints; executable admission additionally enforces canonical bytes, source proofs, unique sorted paths, cross-field limits and exact replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "engine",
    "subject",
    "members",
    "bundle_id"
  ],
  "properties": {
    "contract": {
      "const": "devostasis.code-analysis.v2"
    },
    "engine": {
      "const": "devostasis.code-engine.v2"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "object_format",
        "roots",
        "repository_id",
        "revision",
        "tree",
        "roots_complete"
      ],
      "properties": {
        "kind": {
          "const": "LOCAL_GIT"
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "roots": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          }
        },
        "repository_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "roots_complete": {
          "type": "boolean"
        }
      }
    },
    "members": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs.json",
        "policy.json",
        "analysis.json",
        "findings.sarif",
        "report.md"
      ],
      "properties": {
        "inputs.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "analysis.json": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "findings.sarif": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "report.md": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
